<UserControl x:Class="WeatherApp.UserControls.Sidebar.SidebarItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WeatherApp.UserControls.Sidebar"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="300" MinWidth="250" Height="40" BorderBrush="LightGray"
             BorderThickness="0,0,0,2">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}"
                                       Value="True" />
                            <Condition Binding="{Binding IsSidebarEditActive}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#BEE6FD" />
                    </MultiDataTrigger>
                    
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="#E6E6E6"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectItemCommand}" />
        </Grid.InputBindings>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" FontSize="16" Text="{Binding LocationName}" />
        <Button Grid.Column="2" Height="24" Width="24" ToolTip="Move Up" Command="{Binding MoveUpCommand}"
                Visibility="{Binding IsSidebarEditActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image Source="/Assets/Images/arrow-up-thick.png" />
        </Button>
        <Button Grid.Column="3" Height="24" Width="24" ToolTip="Move Down" Command="{Binding MoveDownCommand}"
                Visibility="{Binding IsSidebarEditActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image Source="/Assets/Images/arrow-down-thick.png" />
        </Button>
        <Button Grid.Column="4" Height="24" Width="24" ToolTip="Remove from list" Command="{Binding RemoveCommand}"
                Visibility="{Binding IsSidebarEditActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image Source="/Assets/Images/close-thick.png" />
        </Button>
    </Grid>
</UserControl>